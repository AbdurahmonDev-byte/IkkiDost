{
  "name": "@ikki-dost/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "db:start": "node scripts/db-start.js",
    "db:ensure": "node scripts/db-ensure.js",
    "db:migrate": "npm run db:ensure && prisma migrate deploy",
    "db:migrate:dev": "npm run db:ensure && prisma migrate dev",
    "db:seed": "npm run db:ensure && node --experimental-strip-types scripts/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ikki-dost/shared-types": "*",
    "@ikki-dost/utils": "*",
    "@ikki-dost/validation": "*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.0",
    "@nestjs/serve-static": "^4.0.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.2.0",
    "@nestjs/websockets": "^10.4.0",
    "@prisma/client": "^5.19.0",
    "argon2": "^0.41.0",
    "helmet": "^7.1.0",
    "prisma": "^5.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.5",
    "socket.io": "^4.7.5",
    "web-push": "^3.6.7",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.22",
    "@swc/core": "^1.16.22",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/web-push": "^3.6.4",
    "embedded-postgres": "^18.6.0-beta.19",
    "typescript": "^5.6.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^2.1.0"
  }
}
