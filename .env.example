# ===== Backend (apps/api/.env) =====
# PostgreSQL connection. For local dev the embedded PostgreSQL server is used
# (see `npm run db:start`); set this to your production database URL when deploying.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ikki_dost?schema=public"

# JWT secrets — MUST be long random strings in production. Never commit real values.
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# API server
PORT=3000
API_PREFIX="api"
# Comma-separated list of allowed origins for CORS (web panels, chef app, desktop)
CORS_ORIGINS="http://localhost:3001,http://localhost:3002,http://localhost:5173"

# Uploads
UPLOAD_DIR="uploads"
MAX_IMAGE_SIZE_BYTES=5242880

# Embedded PostgreSQL (local development only)
EMBEDDED_PG_PORT=5433
EMBEDDED_PG_DIR=".pgdata"

# Web Push (VAPID) for chef app notifications — generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@ikkidost.uz"

# ===== Telegram (shared by API and bot) =====
# Bot token from @BotFather. The API uses it to validate Mini App initData and
# to send bot notifications; the bot uses it to poll Telegram.
BOT_TOKEN=""
# Bot username without the leading @ (used for the phone-verification deep link).
BOT_USERNAME="ikkidostbot"
# Additional Telegram IDs allowed to sign in as OWNER (OWNER password is still required).
OWNER_TELEGRAM_IDS="7483287151,317080284"
# How long a Mini App initData payload stays valid (seconds).
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# ===== Desktop cashier (Windows kassa) =====
# "on" lets the desktop cashier open without login as the dedicated `kassa`
# CASHIER account. Deactivate that employee in the owner panel to stop it.
CASHIER_KIOSK="off"
# Optional but recommended: shared key embedded in the Windows build
# (GitHub secret CASHIER_KIOSK_KEY). Requests without it are refused.
CASHIER_KIOSK_KEY=""

# Serve the built Mini App from the API at `/` (apps/mini-app/dist).
# Leave unset for the default relative path `../mini-app/dist` (cwd = apps/api).
# MINI_APP_DIR="../mini-app/dist"

# ===== Telegram Bot (apps/bot/.env) =====
BOT_TOKEN=""
BOT_USERNAME="ikkidostbot"
API_URL="http://localhost:3000/api"
MINI_APP_URL="http://localhost:5174"
BOT_NOTIFY_INTERVAL_MS=10000
BOT_STORE_PATH="data/sessions.json"

# ===== Seed (apps/api) =====
# Password for the dedicated self-service actor (`bot`). Falls back to SEED_PASSWORD.
SEED_BOT_PASSWORD=""
