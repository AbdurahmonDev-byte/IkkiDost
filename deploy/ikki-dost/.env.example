# Copy to .env on the server and keep the file private (chmod 600).
POSTGRES_PASSWORD=generate-a-long-random-hex-value
JWT_ACCESS_SECRET=generate-a-long-random-hex-value
JWT_REFRESH_SECRET=generate-another-long-random-hex-value

# Add these privately for the Telegram bot and Mini App authentication.
BOT_TOKEN=
BOT_USERNAME=ikkidostbot
OWNER_TELEGRAM_IDS=7483287151,317080284
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
BOT_NOTIFY_INTERVAL_MS=10000

# Change these before running the first seed.
SEED_OWNER_PASSWORD=replace-with-a-unique-owner-password
SEED_PASSWORD=replace-with-a-unique-staff-password
# Optional: password for the dedicated self-service actor (`bot`).
# Falls back to SEED_PASSWORD when empty.
SEED_BOT_PASSWORD=
